# API root. Do not add endpoint paths here.
VITE_API_BASE_URL=https://staging.fastor.ai/v1/

# Endpoint paths are configurable because only the login path was supplied explicitly.
VITE_API_SIGNUP_ENDPOINT=/pwa/user/signup
VITE_API_LOGIN_ENDPOINT=/pwa/user/login
VITE_API_RESTAURANTS_ENDPOINT=/pwa/restaurant/list

# Keep false for normal usage. When true, eligible API failures can use mock catalog data.
VITE_DEMO_MODE=false